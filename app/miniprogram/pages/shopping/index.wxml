<view class="page"><view class="eyebrow">GOOD FOOD · GOOD DAYS</view><view class="row between"><view class="pill">{{space}}</view><view wx:if="{{busy}}" class="muted">处理中…</view></view><view wx:if="{{error}}" class="warning error">{{error}}</view><view class="title">买齐，再开火</view><view class="subtitle">先看看家里有什么，再决定买什么。</view><view class="card"><view class="row"><picker mode="date" value="{{start}}" data-field="start" bindchange="field"><view class="picker">{{start}}</view></picker><text>至</text><picker mode="date" value="{{end}}" data-field="end" bindchange="field"><view class="picker">{{end}}</view></picker></view><view class="actions"><button class="primary" id="action-previewList" bindtap="previewList">汇总食材并核对</button></view></view><view wx:if="{{preview}}" class="hero"><view class="heading">确认家里已有的食材</view><view class="note">同单位填写已有数量；数量不明确的项目会保留为待确认。</view><view wx:for="{{preview.items}}" wx:key="id" class="card"><view class="heading">{{item.name}}</view><view class="muted">需要 {{item.required}} {{item.unit}} {{item.unknown?'＋ 未明确用量':''}}</view><view class="row field"><input class="grow" type="digit" placeholder="已有多少？" data-index="{{index}}" bindinput="previewAvailable" value="{{item.available}}"/><button bindtap="previewEnough" data-index="{{index}}">{{item.enough?'✓ 已够用':'家里够用'}}</button></view></view><button class="primary wide" id="action-confirmList" bindtap="confirmList">确认生成采购清单</button></view><view wx:for="{{lists}}" wx:key="id" wx:for-item="list" class="card"><view class="heading">{{list.start}} — {{list.end}}</view><view wx:for="{{list.items}}" wx:key="id" class="field"><view class="row"><view class="checkbox {{item.bought?'checked':''}}" data-list="{{list.id}}" data-id="{{item.id}}" bindtap="toggleBought">{{item.bought?'✓':''}}</view><view class="grow {{item.bought?'done':''}}"><view>{{item.name}} <text class="badge">{{item.purchase===null?'待核对':item.purchase}} {{item.unit}}</text></view><view class="note">{{item.sourceNames || '手动添加'}} {{item.removedFromPlan?'· 已从菜单移除':''}}</view></view><button class="ghost" bindtap="claim" data-list="{{list.id}}" data-id="{{item.id}}">{{item.assigneeLabel || '认领'}}</button></view></view><input placeholder="顺便买点水果、牛奶…" value="{{newItem}}" data-field="newItem" bindinput="field"/><view class="actions"><button data-id="{{list.id}}" bindtap="addManual">补充</button><button data-id="{{list.id}}" bindtap="refreshList">按菜单更新</button><button class="danger" data-id="{{list.id}}" bindtap="deleteList">删除</button></view></view></view>