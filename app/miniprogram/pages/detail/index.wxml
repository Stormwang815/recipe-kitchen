<view class="page"><view class="eyebrow">GOOD FOOD · GOOD DAYS</view><view class="row between"><view class="pill">{{space}}</view><view wx:if="{{busy}}" class="muted">处理中…</view></view><view wx:if="{{error}}" class="warning error">{{error}}</view><block wx:if="{{recipe}}"><view class="title">{{recipe.title}}</view><view class="subtitle">{{recipe.author || '我的家常味道'}} · {{recipe.servings}} 人份</view><view class="actions"><button class="primary" id="action-cook" bindtap="cook">开始跟做</button><button bindtap="edit">编辑菜谱</button></view><view class="card"><view class="heading">准备食材</view><view wx:for="{{recipe.ingredients}}" wx:key="index" class="row between field"><text>{{item.name}}</text><text class="muted">{{item.quantity || '适量 / 未说明'}} {{item.unit}}</text></view></view><view wx:for="{{recipe.steps}}" wx:key="id" class="card"><view class="step-number">STEP {{index+1}}</view><image wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" class="step-image"/><view class="heading">{{item.text}}</view><view wx:if="{{item.seconds>0}}" class="pill">计时 {{item.seconds}} 秒</view></view><view class="card"><view class="heading">安排进菜单</view><view class="row field"><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="picker">{{date}}</view></picker><picker range="{{meals}}" bindchange="mealChange"><view class="picker">{{meal}}</view></picker><input class="small" type="number" value="{{servings}}" data-field="servings" bindinput="field"/></view><button id="action-planRecipe" bindtap="planRecipe">加入食谱日历</button></view><view class="card"><view class="heading">厨房小记</view><view class="note">{{recipe.notes || '记下这次的调整，下次做得更合口味。'}}</view><input placeholder="例如：下次少放一点盐" value="{{newNote}}" data-field="newNote" bindinput="field"/><button bindtap="addNote">添加备注</button></view><view class="actions"><button wx:if="{{recipe.source}}" bindtap="copySource">复制来源链接</button><button wx:if="{{!isShared}}" bindtap="copyToKitchen">复制到共享厨房</button><button class="danger" bindtap="deleteRecipe">删除菜谱</button></view></block><view wx:else class="empty">菜谱不存在或已删除。</view></view>