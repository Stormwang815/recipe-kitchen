<view class="page"><view class="eyebrow">GOOD FOOD · GOOD DAYS</view><view class="row between"><view class="pill">{{space}}</view><view wx:if="{{busy}}" class="muted">处理中…</view></view><view wx:if="{{error}}" class="warning error">{{error}}</view><view class="title">我的菜谱本</view><view class="subtitle">每一道，都值得再做一次。</view><view class="field"><input placeholder="搜索菜名、食材、作者或标签" value="{{query}}" data-field="query" bindinput="field"/></view><view class="actions"><button class="primary" id="action-newRecipe" bindtap="newRecipe">＋ 新建菜谱</button><button bindtap="importRecipe">导入整理</button></view><view wx:for="{{recipes}}" wx:key="id" class="card" bindtap="openRecipe" data-id="{{item.id}}"><view class="row"><image wx:if="{{item.steps[0].image}}" class="thumbnail" src="{{item.steps[0].image}}" mode="aspectFill"/><view class="grow"><view class="heading">{{item.title}}</view><view class="muted">{{item.servings}} 人份 · {{item.steps.length}} 个步骤</view><view class="pill">{{item.tags || '家常菜'}}</view><view class="note">{{item.author}}</view></view><text>›</text></view></view><view wx:if="{{!recipes.length}}" class="empty">这里还没有菜谱。 把下一道想吃的菜放进来。</view></view>