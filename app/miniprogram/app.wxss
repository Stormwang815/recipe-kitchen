page{background:#f6f5f0;color:#25392d;font-size:29rpx;font-family:-apple-system,BlinkMacSystemFont,sans-serif}.page{padding:36rpx 30rpx 70rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#7d887a;margin-bottom:14rpx}.title{font-size:55rpx;font-weight:650;letter-spacing:2rpx;line-height:1.3;margin-bottom:18rpx}.subtitle,.muted{color:#858a7e;font-size:25rpx;line-height:1.7}.hero{padding:38rpx;background:#e5eadc;border-radius:30rpx;margin:28rpx 0}.hero .title{font-size:44rpx}.card{background:#fff;border-radius:24rpx;padding:30rpx;margin:22rpx 0;border:1rpx solid #eeeee5}.row{display:flex;align-items:center;gap:18rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.heading{font-size:32rpx;font-weight:600;margin:14rpx 0}.pill{font-size:23rpx;background:#edf1e7;color:#55704d;padding:9rpx 18rpx;border-radius:25rpx;display:inline-block;margin:8rpx 8rpx 8rpx 0}.warning{color:#96612e;background:#fbf0dd;padding:20rpx;border-radius:16rpx;font-size:25rpx;margin:18rpx 0;line-height:1.6}.error{color:#a44036}.empty{text-align:center;padding:70rpx 20rpx;color:#8b8c82;line-height:1.9}.field{margin:22rpx 0}.label{font-size:25rpx;color:#78816f;margin:14rpx 0}input,textarea,.picker{box-sizing:border-box;background:#f3f4ee;border:1rpx solid #e8ebdf;border-radius:15rpx;padding:21rpx;width:100%;min-height:85rpx}textarea{height:190rpx;line-height:1.6}.small{width:120rpx;flex-shrink:0}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin:22rpx 0}button{font-size:27rpx;border-radius:17rpx;margin:0;padding:0 26rpx;background:#e8ecdf;color:#315e44;line-height:80rpx}button::after{border:none}.primary{background:#315e44;color:#fff}.danger{background:#fbebe5;color:#a44036}.ghost{background:transparent;border:1rpx solid #d6ddcf}.wide{width:100%}.thumbnail{width:140rpx;height:140rpx;border-radius:16rpx;background:#e5eadc}.step-image{width:100%;border-radius:18rpx;margin:18rpx 0}.step-number{color:#8c9a7d;font-size:24rpx;letter-spacing:3rpx}.cooktext{font-size:40rpx;line-height:1.9;margin:28rpx 0}.timer{font-size:60rpx;font-variant-numeric:tabular-nums;color:#315e44}.date-row{display:flex;overflow-x:auto;gap:12rpx;margin:28rpx 0}.date{padding:18rpx 22rpx;background:#fff;border-radius:18rpx;white-space:nowrap;text-align:center}.selected{background:#315e44;color:white}.done{opacity:.5;text-decoration:line-through}.divider{height:1rpx;background:#ebeee4;margin:24rpx 0}.badge{font-size:23rpx;color:#8b6d43}.note{font-size:24rpx;line-height:1.7;color:#6e7768}.checkbox{width:46rpx;height:46rpx;border:2rpx solid #bac7b1;border-radius:13rpx;text-align:center;line-height:46rpx;flex-shrink:0}.checked{background:#315e44;color:white;border-color:#315e44}.inline{display:inline-block}.space{height:30rpx}
